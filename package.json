{
  "name": "az-sc900-four-week-study-guide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.ts",
    "validate": "node scripts/validate-content.mjs && node scripts/check-language.mjs && npm test && vue-tsc --noEmit",
    "build": "npm run validate && vite build && node scripts/static-pages.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"content/**/*.md\" \"data/*.json\" \"*.{json,ts,md,html}\" \".github/workflows/*.yml\" \"public/*.{json,html}\" \"wrangler.jsonc\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"content/**/*.md\" \"data/*.json\" \"*.{json,ts,md,html}\" \".github/workflows/*.yml\" \"public/*.{json,html}\" \"wrangler.jsonc\""
  },
  "dependencies": {
    "marked": "^16.2.1",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vue-tsc": "^3.1.1",
    "wrangler": "^4.45.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
